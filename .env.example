# Vercel → Settings → Environment Variables 에 넣을 값 (이 파일 자체는 올리지 않아도 됨)

# Supabase → Connect → Transaction pooler 의 URI (포트 6543). [YOUR-PASSWORD] 자리를 DB 비밀번호로 바꾼다.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# 로그인 토큰 서명용. 32자 이상 무작위 문자열(바꾸면 모두 다시 로그인)
APP_SECRET=여기에-32자-이상-무작위-문자열

# 교사·연구자 화면 비밀번호(8자 이상, 서로 다르게)
TEACHER_PASSWORD=
RESEARCHER_PASSWORD=

# 하루 한 번 점검 작업 보호용 무작위 문자열(Vercel이 자동으로 함께 보냄)
CRON_SECRET=

# (선택) Claude API. 없으면 규칙 판정만 쓴다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=medium
